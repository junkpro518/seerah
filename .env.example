# ── Supabase (م١ يستهلك قاعدة م٠ السحابية بلا تغيير مخطط) ──

# عام (يدخل حزمة المتصفح) — مفتاح anon فقط. RLS هو الحارس.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# خادم فقط (ممنوع في المتصفح — SC-008). يتجاوز RLS؛ يُستخدم في lib/supabase/admin.ts حصرًا.
# لا يُسبَق بـ NEXT_PUBLIC_ إطلاقًا، ولا يُلتزم في Git.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
